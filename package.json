{
  "name": "minkflow",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "pnpm --filter @minkflow/web test:e2e",
    "render:fixtures": "pnpm --filter @minkflow/render render:fixtures",
    "db:local": "pnpm --filter @minkflow/db db:local",
    "db:migrate": "pnpm --filter @minkflow/db db:migrate --",
    "verify:supabase": "pnpm --filter @minkflow/db verify:supabase",
    "dev:web": "pnpm --filter @minkflow/web dev",
    "dev:worker": "pnpm --filter @minkflow/worker dev",
    "e2e:local": "pnpm --filter @minkflow/pipeline e2e:local",
    "verify:providers": "pnpm --filter @minkflow/worker verify:providers",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "^3.6.0",
    "turbo": "^2.11.10",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  }
}
