{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["APP_ENV", "NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_*", "PRODUCT_NAME"],
      "passThroughEnv": [
        "APP_*", "ALLOWED_ORIGINS", "ADMIN_EMAILS", "AUTH_DRIVER", "DEV_AUTH_SECRET", "DATABASE_*", "QUEUE_DRIVER", "REDIS_URL",
        "STORAGE_DRIVER", "LOCAL_STORAGE_*", "S3_*", "SIGNED_URL_TTL_SECONDS", "AI_*", "OPENAI_*", "ELEVENLABS_*",
        "MAX_ACTIVE_JOBS_PER_WORKSPACE", "PLATFORM_DAILY_SPEND_CAP_USD", "WORKSPACE_DAILY_SPEND_CAP_USD", "RENDER_CONCURRENCY",
        "GOOGLE_OAUTH_*", "TOKEN_ENCRYPTION_KEY", "PAYMENTS_ENABLED", "PAYSTACK_*", "SENTRY_*", "LOG_LEVEL", "SUPABASE_*", "POSTGRES_*"
      ]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "outputs": [] },
    "test:integration": { "cache": false }
  }
}
