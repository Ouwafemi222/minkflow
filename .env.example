# Minkflow environment template. Examples only — never commit real secrets.
# Copy to apps/web/.env.local and apps/worker/.env. See docs/SETUP-ACCOUNTS.md.

# --- Brand (V3/V4 founder decision; domain NOT verified) ---
PRODUCT_NAME=Minkflow
NEXT_PUBLIC_PRODUCT_NAME=Minkflow

# --- App ---
NODE_ENV=development
APP_ENV=local                      # local | staging | production
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
ADMIN_EMAILS=                      # comma-separated emails allowed into /admin

# --- Supabase (web + worker) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # server/worker only, never in browser
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Queue ---
QUEUE_DRIVER=inline                # inline (dev, no Redis) | bullmq
REDIS_URL=redis://127.0.0.1:6379

# --- Object storage (Cloudflare R2, S3-compatible) ---
STORAGE_DRIVER=local               # local (dev, ./.data/storage) | s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=minkflow-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=900

# --- AI providers (worker only) ---
AI_PROVIDER_MODE=mock              # mock | live
OPENAI_API_KEY=
OPENAI_MODEL_SCRIPT=               # TO VERIFY: pin a current model name
OPENAI_MODEL_STORYBOARD=           # TO VERIFY
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=               # TO VERIFY
ELEVENLABS_VOICE_IDS=              # comma-separated allowlisted voice IDs

# --- Limits and spend caps ---
RENDER_CONCURRENCY=1
MAX_ACTIVE_JOBS_PER_WORKSPACE=3
PLATFORM_DAILY_SPEND_CAP_USD=25
WORKSPACE_DAILY_SPEND_CAP_USD=5

# --- Payments (Paystack, USD) ---
PAYSTACK_SECRET_KEY=               # also used to verify webhook signatures (HMAC SHA-512)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=USD

# --- Observability ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info

# --- Remotion ---
REMOTION_LICENSE_KEY=              # TO VERIFY: Company License; runtime use unconfirmed
