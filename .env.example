# Minkflow environment template. Examples only — never commit real secrets.
# Local dev: copy to `.env.local` at the repository root (read by both apps/web and apps/worker).
# Hosted: set the same names in Vercel (web) and Railway (worker). See docs/SETUP-ACCOUNTS.md.

# --- Brand (domain NOT verified; never hardcode one — use APP_BASE_URL) ---
PRODUCT_NAME=Minkflow
NEXT_PUBLIC_PRODUCT_NAME=Minkflow

# --- App ---
APP_ENV=local                      # local | staging | production
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
ADMIN_EMAILS=                      # comma-separated emails allowed into /studio/admin

# --- Auth ---
AUTH_DRIVER=dev                    # dev (APP_ENV=local only: email-only sign-in, no Supabase) | supabase
DEV_AUTH_SECRET=change-me-local-dev-secret-32chars

# --- Supabase (web: auth; web + worker: DATABASE_URL) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # server only; currently unused by code (DB access goes through DATABASE_URL)
# Local Docker-free Postgres: `pnpm db:local` (PGlite on 54329). Hosted: Supabase pooler connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres

# --- Queue (Postgres is the source of truth; Redis only wakes workers faster) ---
QUEUE_DRIVER=postgres              # postgres (poll, no Redis) | bullmq
REDIS_URL=redis://127.0.0.1:6379

# --- Object storage (Cloudflare R2, S3-compatible) ---
STORAGE_DRIVER=local               # local (dev only, files under LOCAL_STORAGE_ROOT) | s3
LOCAL_STORAGE_ROOT=.data/storage   # relative to the repository root
LOCAL_STORAGE_SECRET=change-me-local-storage-secret
S3_ENDPOINT=                       # https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=minkflow-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=900

# --- AI providers (worker; web reads ELEVENLABS_VOICE_IDS for the voice picker) ---
AI_PROVIDER_MODE=mock              # mock (offline placeholders) | live (staging/production)
OPENAI_API_KEY=
OPENAI_MODEL_SCRIPT=               # TO VERIFY (V-01): pin a current model name
OPENAI_MODEL_STORYBOARD=           # TO VERIFY (V-01)
OPENAI_MODEL_MODERATION=omni-moderation-latest   # TO VERIFY (V-01)
OPENAI_INPUT_USD_PER_1M=           # TO VERIFY: used only for spend estimates
OPENAI_OUTPUT_USD_PER_1M=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=               # TO VERIFY (V-02)
ELEVENLABS_VOICE_IDS=              # id:Display Name:short description, comma-separated allowlist
ELEVENLABS_USD_PER_1K_CHARS=       # TO VERIFY (V-03): used only for spend estimates

# --- Limits and spend caps ---
RENDER_CONCURRENCY=1
AI_CONCURRENCY=4
MAX_ACTIVE_JOBS_PER_WORKSPACE=3
PLATFORM_DAILY_SPEND_CAP_USD=25
WORKSPACE_DAILY_SPEND_CAP_USD=3
JOB_LEASE_SECONDS=60
WORKER_PORT=8081
# Optional worker settings (defaults shown):
# WORKER_TEMP_DIR=                  # OS temp dir; render scratch space
# RETENTION_SWEEP_ENABLED=true      # hourly deletion of expired previews/renders/narration
# REMOTION_CHROME_CONCURRENCY=      # Remotion's own default when unset

# --- Payments (Paystack, USD). Off until USD settlement is approved (ADR-008). ---
PAYMENTS_ENABLED=false
PAYSTACK_SECRET_KEY=               # server only; also verifies webhook signatures (HMAC SHA-512)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=USD

# --- Observability ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info

# --- Remotion ---
REMOTION_LICENSE_KEY=              # TO VERIFY (V-04): Company License; runtime use unconfirmed
